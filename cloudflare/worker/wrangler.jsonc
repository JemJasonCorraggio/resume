{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "career-inventory-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "assets": {
    "directory": "../../data",
    "binding": "INVENTORY_ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MAX_TOKENS": 2048,
    "AI_GATEWAY_ID": "default",
    "MAX_REQUIREMENTS_PER_JOB": 15
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "career-inventory-db",
      "database_id": "94f5d31e-6aa8-406f-9097-6982b0043871",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
