{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "career-inventory-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "assets": {
    "directory": "../../data",
    "binding": "INVENTORY_ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
